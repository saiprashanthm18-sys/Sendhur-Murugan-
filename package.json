{
  "name": "campus-cafeteria-system",
  "version": "1.0.0",
  "description": "Campus Cafeteria Pre-Order and Queue Management System (MERN)",
  "scripts": {
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "concurrently \"npm --prefix backend start\" \"npm --prefix frontend run preview\"",
    "seed": "node backend/seedData.js",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
